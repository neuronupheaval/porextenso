@{
    ViewData["Title"] = "Home";
}

@section Styles
{
<link rel="stylesheet" href="~/css/Home/Index.css?v=@(System.Random.Shared.NextDouble())" />
}

<div class="text-center">
    <h1 class="display-4">Bem-vindo(a)!</h1>
    <form class="form" onsubmit="return false;">
        <div id="start" class="on">
            <p>
Este app converte n&uacute;meros para a sua vers&atilde;o por extenso.
<br />
Clique no bot&atilde;o abaixo para iniciar a aplica&ccedil;&atilde;o!
            </p>
            <input type="button" value="Iniciar" class="btn btn-success" onclick="startButtonClicked()" />
        </div>
        <div id="app" class="off">
            <label for="number" class="form-label">Informe n&uacute;mero <span class="bi bi-question-circle showTooltip" title="Gerador de n&uacute;meros por extenso! Digite-o e depois clique no extenso abaixo, para copiar."></span> </label>
            <input type="number" id="number" name="number" class="underlined" />
            <input type="button" value="Limpar" class="btn btn-danger btn-sm showTooltip" onclick="clearNumber()" title="Limpar entrada." />
            <input type="button" value="&nbsp;Colar&nbsp;" class="btn btn-info btn-sm showTooltip" onclick="pasteNumber()" title="Colar d&iacute;gitos na entrada ao lado." />
        </div>
    </form>
    <div id="result" onclick="copy()"></div>
</div>

@section Scripts 
{
<script type="text/javascript" src="~/js/Home/Index.js?v=@(System.Random.Shared.NextDouble())"></script>
}
