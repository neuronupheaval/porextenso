@{
    ViewData["Title"] = "Home";
}

@section Styles
{
<link rel="stylesheet" href="~/css/Home/Index.css?v=@(System.Random.Shared.NextDouble())" />
}

<div class="text-center">
    <h1 class="display-4">Bem-vindo(a)!</h1>
    <form class="form" onsubmit="return false;">
        <label for="number" class="form-label">Informe número <span class="bi bi-question-circle showTooltip" title="Gerador de n&uacute;meros por extenso! Digite-o e depois clique no extenso abaixo, para copiar."></span> </label>
        <input type="number" id="number" name="number" class="underlined" required />
        <input type="button" value="Limpar" class="btn btn-danger btn-sm" onclick="clearNumber()" />
        <input type="button" value="&nbsp;Colar&nbsp;" class="btn btn-info btn-sm" onclick="pasteNumber()" />
    </form>
    <div id="result" onclick="copy()"></div>
</div>

@section Scripts 
{
<script type="text/javascript" src="~/js/Home/Index.js?v=@(System.Random.Shared.NextDouble())"></script>
}
